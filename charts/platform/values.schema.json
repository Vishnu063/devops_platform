{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "image",
    "replicaCount",
    "production",
    "resources",
    "pdb",
    "autoscaling",
    "networkPolicy",
    "ingress"
  ],
  "properties": {
    "production": {
      "type": "boolean"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "pattern": "^([a-f0-9]{40})?$"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "pdb": {
      "type": "object",
      "properties": {
        "minAvailable": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "monitoringNamespace": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "controllerPodLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "production": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "image": {
            "properties": {
              "digest": {
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          },
          "replicaCount": {
            "minimum": 3
          },
          "pdb": {
            "properties": {
              "minAvailable": {
                "minimum": 2
              }
            }
          },
          "networkPolicy": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "autoscaling": {
            "properties": {
              "minReplicas": {
                "minimum": 3
              }
            }
          }
        }
      }
    }
  ]
}
