{
  "uid": "devops-platform",
  "title": "DevOps Platform — Application Monitoring",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "devops",
    "flask",
    "jenkins"
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Application up",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"devops-platform\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN"
                },
                "1": {
                  "text": "UP"
                }
              }
            }
          ]
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total HTTP requests (excluding health & metrics)",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 9,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(platform_http_requests_total) or vector(0)"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Request rate per second",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(platform_http_requests_total[5m]))",
          "legendFormat": "requests/s"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "5xx errors per second",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(platform_http_requests_total{status=~\"5..\"}[5m])) or vector(0)",
          "legendFormat": "5xx/s"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Average request latency (seconds)",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(platform_http_request_duration_seconds_sum[5m])) / clamp_min(sum(rate(platform_http_request_duration_seconds_count[5m])), 0.000001)",
          "legendFormat": "average latency"
        }
      ]
    }
  ]
}
